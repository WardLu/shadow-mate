{
  "name": "shadow-mate",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local-dev": "node scripts/start-local-dev.mjs",
    "check:integration": "node scripts/check-integration.mjs",
    "build": "vite build",
    "check": "node scripts/check.mjs",
    "public:check": "node scripts/public-check.mjs",
    "security:check": "node scripts/security-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:promote": "node scripts/release/promote-to-production.mjs",
    "release:production": "bash scripts/release/deploy-production.sh",
    "seo:audit": "node scripts/seo/audit-prerendered-html.mjs",
    "seo:live": "node scripts/seo/audit-live-site.mjs",
    "verify": "npm run public:check && npm run security:check && npm run check && npm run build && node scripts/check-build.mjs && npm run seo:audit && npm run test:coverage",
    "ci:offline": "node scripts/ci/offline-checks.mjs",
    "ci:offline:parallel": "node scripts/ci/offline-checks.mjs --parallel",
    "timing:record": "node scripts/testing/task-timing.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:fast": "npm run check && npm run test:unit",
    "test:ui": "node scripts/run-e2e.mjs tests/e2e/offline.spec.js",
    "test:full": "npm run verify && npm run test:db && npm run test:functions && npm run test:e2e && npm run release:check",
    "test:coverage": "vitest run --coverage",
    "supabase:local:start": "node scripts/start-shared-supabase.mjs",
    "supabase:local:functions:serve": "node scripts/serve-shared-functions.mjs",
    "test:db": "node scripts/test-shared-db.mjs",
    "test:functions": "node scripts/test-delete-account-guard.mjs",
    "test:e2e": "node scripts/run-e2e.mjs --project=chromium",
    "test:e2e:mobile": "node scripts/run-e2e.mjs --project=mobile-360 --project=mobile-390 --project=tablet-portrait --project=tablet-landscape",
    "tts:catalog": "node scripts/tencent-tts-prewarm.mjs --dry-run",
    "tts:prewarm": "node --env-file-if-exists=.env.tts.local scripts/tencent-tts-prewarm.mjs",
    "tts:smoke": "node scripts/tencent-tts-smoke.mjs",
    "ci": "npm run ci:offline && node scripts/ci/record-local-ci.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@sentry/browser": "11.6.0",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/analytics": "^2.0.1",
    "fflate": "0.8.3",
    "lucide": "^1.54.0",
    "pinyin-pro": "3.29.4"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.6",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "cos-nodejs-sdk-v5": "3.0.0",
    "jsdom": "30.1.2",
    "supabase": "2.117.0",
    "tencentcloud-sdk-nodejs-tts": "4.1.237",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}

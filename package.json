{
  "name": "shadow-mate",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check.mjs",
    "security:check": "node scripts/security-check.mjs",
    "verify": "npm run security:check && npm run check && npm run build && node scripts/check-build.mjs && npm run test:coverage",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage",
    "test:db": "supabase test db --local",
    "test:functions": "node scripts/test-delete-account-guard.mjs",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "lucide": "^1.28.0"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "jsdom": "30.0.1",
    "supabase": "2.111.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}

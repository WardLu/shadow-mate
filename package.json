{
  "name": "shadow-mate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check.mjs",
    "security:check": "node scripts/security-check.mjs",
    "verify": "npm run security:check && npm run check && npm run build && node scripts/check-build.mjs && npm run test:unit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "supabase": "2.111.0",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
